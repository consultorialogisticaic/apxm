# The service images build from the checkout, so the build context is the
# checkout: sources, contracts, lockfiles and the release descriptors. Nothing
# a build produces is an input to it, and host build output is the one thing an
# image must never inherit -- a stale host binary in `target/` would be copied
# into a Linux image and hashed into its release manifest.
/target/
**/target/
**/node_modules/
**/dist/
**/build/
**/__pycache__/
*.py[cod]
*.egg-info/

# Host state, environments and evidence. `.git` is excluded on purpose: an
# image build is handed its source revision and proves it by regenerating the
# cohort's descriptors, so it needs no history.
.git/
.dekk/
.apxm/
.venv/
.venv-*/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# The frontend bridge is copied into the Python package by an install step; the
# image builds its own Linux bridge and must not inherit a host one.
/crates/compiler/frontend/python/apxm_program/_native.so

# Credentials never enter a build context, whatever a checkout or a developer
# machine happens to hold next to the sources.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
.netrc
.npmrc
.pypirc
.aws/
.ssh/
.docker/
.git-credentials
